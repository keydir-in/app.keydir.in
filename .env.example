# =============================================================================
# KeyDir — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Required variables must be set for the app to function.
# Optional variables have safe defaults or are only needed for specific features.
# =============================================================================

# ---------------------------------------
# Database (Prisma)
# ---------------------------------------
# Required. PostgreSQL connection string from Supabase.
# For production, use the pooled connection (port 6543 with pgbouncer=true).
# For local Supabase, use port 5432 without pgbouncer.
#
# Examples:
#   Production: postgresql://postgres.xxx:password@aws-1-pooler.supabase.com:6543/postgres?pgbouncer=true
#   Local:      postgresql://postgres:password@localhost:5432/keydir
DATABASE_URL=

# ---------------------------------------
# Better Auth
# ---------------------------------------
# Required. Base URL of the application.
# Development: http://localhost:3000
# Production:  https://app.keydir.in
BETTER_AUTH_URL=http://localhost:3000

# Required. Secret used to sign session cookies.
# Generate with: openssl rand -hex 32
# NEVER expose this in client code.
BETTER_AUTH_SECRET=

# Required. Better Auth Infrastructure API key (from the Better Auth dashboard).
# Do NOT commit the real value — keep it in Vercel / .env only.
BETTER_AUTH_API_KEY=

# Optional. Better Auth Infrastructure API/KV URLs (only if overridden in the dashboard).
BETTER_AUTH_API_URL=
BETTER_AUTH_KV_URL=

# Required for Google OAuth via Better Auth.
# Google Cloud Console > Credentials > OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional for Discord OAuth via Better Auth (needed for voting eligibility).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------------------------------------
# Email (Resend)
# ---------------------------------------
# Required for password-reset emails. Found in Resend Dashboard > API Keys.
# NEVER expose this to client-side code.
RESEND_API_KEY=

# Required. ID of the "KeyDir Password Reset" template in Resend Dashboard > Templates.
# The template renders the email body; this app only passes USER_NAME and RESET_URL.
# NEVER expose this to client-side code.
RESEND_PASSWORD_RESET_TEMPLATE_ID=

# From address shown on password-reset emails.
# IMPORTANT: the domain MUST be verified in Resend (Dashboard > Domains).
# `keydir.in` is verified for this project; `app.keydir.in` is not.
EMAIL_FROM=KeyDir <noreply@keydir.in>

# ---------------------------------------
# Supabase
# ---------------------------------------
# Required. Found in Supabase Dashboard > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------
# App
# ---------------------------------------
# Required. Base URL of the application.
# Development: http://localhost:3000
# Production:  https://app.keydir.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required. Comma-separated list of email addresses allowed to access /admin routes.
ADMIN_EMAILS=admin@example.com

# Required. Shared secret for the server-to-server cache revalidation endpoint
# (POST /api/revalidate). Used by the external scraper/admin system to
# invalidate product/filter cache entries after price or spec updates.
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=

# ---------------------------------------
# Cloudinary
# ---------------------------------------
# Required for image upload functionality.
# Found in Cloudinary Dashboard > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# ---------------------------------------
# Optional
# ---------------------------------------
# Password required to confirm product deletion in the admin panel.
DELETE_PASSWORD=

# Secret token for authenticating cron job requests.
# Generate a random string: openssl rand -hex 32
# Used as Bearer token in the Authorization header.
CRON_SECRET=

# Enable verbose logging for the scraper engine (true/false).
SCRAPER_DEBUG=false
